# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O arquivo .env NAO e versionado (esta no .gitignore).

# URL da API que sera testada (com a porta)
BASE_URL=http://localhost:3000

# E-mail do administrador cadastrado na API
ADMIN_EMAIL=admin@escola.com

# Senha do administrador cadastrado na API
ADMIN_SENHA=admin123
